  "semanticTokenColors": {
    "type": "#58C6DB",
    "class": "#58C6DB",
    "enum": "#58C6DB",
    "namespace": "#58C6DB",
    "typeParameter": "#58C6DB",
    "function": "#93C430",
    "method": "#93C430",
    "macro": "#E02267",
    "parameter": "#E5E5D4",
    "variable": "#E5E5D4",
    "property": "#E5E5D4",
    "keyword": "#E4881C",
    "string": "#D3C864",
    "number": "#9A6BEF"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#676457",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.character",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#D3C864"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#9A6BEF"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#E4881C"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "meta.preprocessor",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#D8D8D8"
      }
    },
    {
      "scope": [
        "support.type",
        "entity.name.type",
        "entity.name.namespace",
        "entity.name.scope-resolution"
      ],
      "settings": {
        "foreground": "#58C6DB"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#93C430"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#E5E5D4"
      }
    },
    {
      "scope": [
        "entity.name.type.class",
        "entity.name.type.struct",
        "entity.name.type.enum"
      ],
      "settings": {
        "foreground": "#58C6DB",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string.quoted.double.include",
        "string.quoted.other.lt-gt.include"
      ],
      "settings": {
        "foreground": "#D3C864"
      }
    }
  ]
}
